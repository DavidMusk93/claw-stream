[Unit]
Description=xstream Backend (FastAPI + BitTorrent)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
WorkingDirectory=/root/xstream
Environment=PYTHONPATH=/root/xstream
EnvironmentFile=/etc/xstream.env
ExecStart=/root/xstream/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8765 --log-level info
Restart=on-failure
RestartSec=5s
User=root

[Install]
WantedBy=multi-user.target
